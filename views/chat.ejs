<%- include("partials/header", { title: "Chat · Dev Firm" }) %>
<h1>Talk to the firm</h1>
<p class="lead">
  Ask a question, describe a change, or point at a repository in plain language.
  The concierge can read your repos, check builds and tickets, and start the
  delivery team — no forms or prepared brief required.
</p>

<div class="split" style="margin-top: 16px;">
  <div class="grow" style="min-width: 0;">
    <div class="card" style="margin-bottom: 16px; height: 560px; overflow-y: auto; display: flex; flex-direction: column;">
      <div id="chat-messages" style="flex: 1; overflow-y: auto; padding: 16px; display: flex; flex-direction: column; gap: 12px;">
        <% if (!messages || !messages.length) { %>
        <div class="empty" style="margin: auto;">
          Say hello, ask how something works, or describe what you want built.
        </div>
        <% } else { %>
        <% for (const msg of messages) { %>
        <div class="chat-msg <%= msg.role %>" style="margin-left: <%= msg.role === 'user' ? 'auto' : '0' %>; max-width: 75%;">
          <div class="chat-bubble">
            <% if (msg.role === 'user') { %>
            <span class="chat-meta">You</span>
            <% } else if (msg.role === 'assistant') { %>
            <span class="chat-meta"><%= msg.agent_role || 'Concierge' %> <span class="badge" style="font-size:10px;">assistant</span></span>
            <% } else { %>
            <span class="chat-meta">System</span>
            <% } %>
            <div class="chat-body"><%= msg.content %></div>
            <span class="chat-time" style="font-size:11px; color: var(--muted); display:block; margin-top:4px;"><%= String(msg.created_at || '').slice(11, 16) %></span>
          </div>
        </div>
        <% } %>
        <% } %>
      </div>
      <div id="chat-typing" style="display:none; padding: 8px 16px; font-size:13px; color: var(--muted); font-style: italic;">Concierge is working…</div>
    </div>

    <div class="card" style="margin-top: 0;">
      <form id="chat-form" style="display: flex; gap: 8px; margin-bottom: 12px;">
        <input
          type="text"
          id="chat-input"
          name="content"
          placeholder="e.g. “Add dark mode to career-firm” or “How does the build pipeline work?”"
          autocomplete="off"
          style="flex: 1; min-width: 0;"
        />
        <button type="submit" class="button" id="chat-send">Send</button>
      </form>
      <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px;">
        <button type="button" class="button secondary small" onclick="sendQuick('Add a dark mode toggle to career-firm')">Add a feature</button>
        <button type="button" class="button secondary small" onclick="sendQuick('How does the build pipeline work?')">Ask how it works</button>
        <button type="button" class="button secondary small" onclick="sendQuick('What is the status of the firm?')">Check status</button>
      </div>
    </div>
  </div>

  <div style="flex: 0 0 340px; min-width: 0;">
    <% if (typeof repos !== 'undefined' && repos && repos.length) { %>
    <div class="card" style="margin-bottom: 16px;">
      <h3 style="font-size: 14px; text-transform: uppercase; letter-spacing: .06em; color: var(--muted); margin-bottom: 12px;">Repositories it can see</h3>
      <p class="small muted" style="margin-top: 0;"><%= repos_root %></p>
      <div style="display: flex; flex-wrap: wrap; gap: 6px;">
        <% for (const repo of repos) { %>
        <button type="button" class="button secondary small repo-chip" data-repo="<%= repo.name %>" title="<%= repo.path %>">📁 <%= repo.name %></button>
        <% } %>
      </div>
    </div>
    <% } else { %>
    <div class="card" style="margin-bottom: 16px;">
      <h3 style="font-size: 14px; text-transform: uppercase; letter-spacing: .06em; color: var(--muted); margin-bottom: 12px;">Repositories</h3>
      <p class="small muted" style="margin: 0;">
        No local repositories found. Set the repositories folder in
        <a href="/settings">Settings</a> or name an absolute path in chat.
      </p>
    </div>
    <% } %>

    <div class="card" style="margin-bottom: 16px;">
      <h3 style="font-size: 14px; text-transform: uppercase; letter-spacing: .06em; color: var(--muted); margin-bottom: 12px;">Try saying</h3>
      <ul style="list-style: none; padding: 0; margin: 0; font-size: 13px; color: var(--muted);">
        <li style="margin-bottom: 10px;">“In career-firm, add a dark mode toggle to the settings page.”</li>
        <li style="margin-bottom: 10px;">“How does niw-tracker handle authentication?”</li>
        <li style="margin-bottom: 10px;">“What’s blocking the latest build?”</li>
        <li style="margin-bottom: 10px;">“Show me the open QA tickets.”</li>
        <li style="margin-bottom: 0;">“Compare the architecture of career-firm and niw-tracker.”</li>
      </ul>
    </div>

    <div class="card">
      <h3 style="font-size: 14px; text-transform: uppercase; letter-spacing: .06em; color: var(--muted); margin-bottom: 12px;">What it can do</h3>
      <ul style="list-style: none; padding: 0; margin: 0; font-size: 13px; color: var(--muted);">
        <li style="margin-bottom: 8px;"><strong>Understand intent:</strong> resolve casual repo names and vague requests into a concrete task.</li>
        <li style="margin-bottom: 8px;"><strong>Read your code:</strong> search and open files to answer questions with real evidence.</li>
        <li style="margin-bottom: 8px;"><strong>Start delivery:</strong> hand a clear brief to the PM → architect → developers → QA pipeline.</li>
        <li style="margin-bottom: 0;"><strong>Report progress:</strong> inspect builds, tickets, agent runs, and artifacts.</li>
      </ul>
    </div>
  </div>
</div>

<script>
const chatForm = document.getElementById('chat-form');
const chatInput = document.getElementById('chat-input');
const chatSend = document.getElementById('chat-send');
const chatMessages = document.getElementById('chat-messages');
const chatTyping = document.getElementById('chat-typing');

function scrollToBottom() {
  chatMessages.scrollTop = chatMessages.scrollHeight;
}

function escapeHtml(text) {
  const div = document.createElement('div');
  div.textContent = text == null ? '' : String(text);
  return div.innerHTML;
}

function renderMarkdown(text) {
  const escaped = escapeHtml(text);
  return escaped
    .split(/(```[\s\S]*?```)/g)
    .map((part) => {
      const fence = part.match(/^```(\w*)\n?([\s\S]*?)```$/);
      if (fence) return '<pre><code>' + fence[2].replace(/\n$/, '') + '</code></pre>';
      return part
        .replace(/`([^`\n]+)`/g, '<code>$1</code>')
        .replace(/\*\*([^*\n]+)\*\*/g, '<strong>$1</strong>')
        .replace(/\[([^\]]+)\]\(((?:https?:\/\/|\/)[^)\s]+)\)/g, '<a href="$2" target="_blank" rel="noopener">$1</a>')
        .replace(/\n/g, '<br>');
    })
    .join('');
}

function addMessage(role, content, agentRole, createdAt) {
  const div = document.createElement('div');
  div.className = 'chat-msg ' + role;
  div.style.marginLeft = role === 'user' ? 'auto' : '0';
  div.style.maxWidth = '75%';
  const meta = role === 'user' ? 'You' : (agentRole || 'Concierge');
  const badge = role === 'assistant' ? ' <span class="badge" style="font-size:10px;">assistant</span>' : '';
  div.innerHTML = `
    <div class="chat-bubble">
      <span class="chat-meta">${escapeHtml(meta)}${badge}</span>
      <div class="chat-body">${renderMarkdown(content)}</div>
      <span class="chat-time" style="font-size:11px; color: var(--muted); display:block; margin-top:4px;">${escapeHtml(createdAt || new Date().toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'}))}</span>
    </div>
  `;
  chatMessages.appendChild(div);
  scrollToBottom();
}

async function loadMessages() {
  try {
    const res = await fetch('/api/chat');
    const data = await res.json();
    const previousScroll = chatMessages.scrollTop;
    const nearBottom =
      chatMessages.scrollHeight - previousScroll - chatMessages.clientHeight < 80;
    chatMessages.innerHTML = '';
    (data.messages || []).forEach((msg) => {
      addMessage(msg.role, msg.content, msg.agent_role, String(msg.created_at || '').slice(11, 16));
    });
    if (nearBottom) scrollToBottom();
    else chatMessages.scrollTop = previousScroll;
  } catch (e) {
    console.error(e);
  }
}

async function sendMessage(content) {
  chatSend.disabled = true;
  chatSend.textContent = 'Sending…';
  chatTyping.style.display = 'block';
  addMessage('user', content, null);
  try {
    const res = await fetch('/api/chat', {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({ content }),
    });
    const data = await res.json();
    if (!res.ok) {
      addMessage('assistant', data.error || 'The request failed. Please try again.', 'concierge');
    } else {
      await loadMessages();
    }
  } catch (e) {
    addMessage('assistant', 'Sorry, I could not reach the concierge. Please try again.', 'concierge');
  } finally {
    chatSend.disabled = false;
    chatSend.textContent = 'Send';
    chatInput.value = '';
    chatTyping.style.display = 'none';
  }
}

function sendQuick(text) {
  chatInput.value = text;
  sendMessage(text);
}

document.querySelectorAll('.repo-chip').forEach((button) => {
  button.addEventListener('click', () => {
    chatInput.value = 'In ' + button.dataset.repo + ', ';
    chatInput.focus();
  });
});

chatForm.addEventListener('submit', (e) => {
  e.preventDefault();
  const content = chatInput.value.trim();
  if (!content) return;
  sendMessage(content);
});

// Load on page load
loadMessages();

// Poll for new messages every 3 seconds while on this page
setInterval(loadMessages, 3000);
</script>
<%- include("partials/footer") %>
