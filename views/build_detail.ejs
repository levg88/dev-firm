<%- include("partials/header", { title: (workflow ? workflow.title : "Build") + " · Dev Firm" }) %>
<div class="split">
  <div class="grow">
    <p class="small muted" style="margin-bottom: 4px;">Build workflow #<%= workflow.id %></p>
    <h1><%= workflow.title %></h1>
    <p class="small muted">
      <span class="badge <%= workflow.status %>"><%= workflow.status %></span>
      · <%= String(workflow.created_at || "").slice(0, 16).replace("T", " ") %> UTC
      <% if (workflow.workspace_path) { %>· <span class="mono small"><%= workflow.workspace_path %></span><% } %>
    </p>
  </div>
  <a class="button secondary" href="/build">New build</a>
</div>

<% if (workflow.status !== "done" && workflow.status !== "failed") { %>
<div class="card" style="margin-top: 18px;">
  <p><span class="spinner"></span> The build team is working. This page refreshes automatically.</p>
  <p class="small muted">PM → architect → team lead → developers → tech lead → QA → devops (looping on failures). This can take several minutes.</p>

  <!-- Progress bar -->
  <div style="margin-top: 14px;">
    <div style="display: flex; justify-content: space-between; margin-bottom: 6px;">
      <span class="small muted" id="phase-label"><%= phaseLabel %></span>
      <span class="small muted" id="iter-label">
        <% if (iteration > 0) { %>Iteration <%= iteration %>/<%= maxIterations %><% } else { %>—<% } %>
      </span>
    </div>
    <div class="progress-bar">
      <div class="progress-fill" id="progress-fill" style="width: 0%;"></div>
    </div>
    <div class="progress-steps" style="margin-top: 10px;">
      <% const phases = ['starting','architect','team_review','developers','tech_lead','qa','devops']; %>
      <% const phaseNames = ['Start','Architect','Team Lead','Developers','Tech Lead','QA','DevOps']; %>
      <% phases.forEach((p, idx) => { %>
      <span class="progress-step" data-phase="<%= p %>">
        <%= phaseNames[idx] %>
      </span>
      <% }); %>
    </div>
  </div>
</div>
<script>
  const phases = ['starting','architect','team_review','developers','tech_lead','qa','devops'];
  function updateProgress(phase, iteration, maxIterations) {
    const idx = phases.indexOf(phase);
    const pct = idx >= 0 ? Math.round(((idx + 1) / phases.length) * 100) : 0;
    document.getElementById('progress-fill').style.width = pct + '%';
    document.querySelectorAll('.progress-step').forEach((el, i) => {
      el.classList.toggle('done', i < idx);
      el.classList.toggle('active', i === idx);
    });
    if (iteration > 0) {
      document.getElementById('iter-label').textContent = 'Iteration ' + iteration + '/' + maxIterations;
    }
  }
  // Initial render
  updateProgress('<%= phase %>', <%= iteration %>, <%= maxIterations %>);

  const timer = setInterval(async () => {
    try {
      const res = await fetch("/build/<%= workflow.id %>/status");
      const data = await res.json();
      if (data.phaseLabel) document.getElementById('phase-label').textContent = data.phaseLabel;
      if (data.phase) updateProgress(data.phase, data.iteration, data.maxIterations);
      if (data.status === "done" || data.status === "failed") {
        clearInterval(timer);
        window.location.reload();
      }
    } catch (e) {}
  }, 4000);
</script>
<% } %>

<% if (workflow.error) { %>
<div class="banner error"><strong>Build failed.</strong><div class="small mono" style="margin-top: 6px;"><%= workflow.error %></div></div>
<% } %>

<h2>Agent calls</h2>
<% if (agent_runs && agent_runs.length) { %>
<div class="card table-wrap">
  <table>
    <thead><tr><th>#</th><th>Role</th><th>Status</th><th>Model</th><th>Tokens</th><th>Error</th></tr></thead>
    <tbody>
    <% for (const run of agent_runs) { %>
      <tr>
        <td><%= run.id %></td>
        <td><strong><%= run.role %></strong></td>
        <td><span class="badge <%= run.status %>"><%= run.status %></span></td>
        <td class="small muted"><%= run.provider %> / <%= run.model %></td>
        <td class="small muted"><%= run.prompt_tokens %> + <%= run.completion_tokens %></td>
        <td class="small muted"><%= run.error || "—" %></td>
      </tr>
    <% } %>
    </tbody>
  </table>
</div>
<% } else { %>
<div class="empty">No agent calls recorded yet.</div>
<% } %>

<h2>Tickets</h2>
<% if (tickets && tickets.length) { %>
<div class="card table-wrap">
  <table>
    <thead><tr><th>Key</th><th>Type</th><th>Title</th><th>Status</th><th>Assignee</th><th>Parent</th><th>GitHub</th></tr></thead>
    <tbody>
    <% for (const ticket of tickets) { %>
      <tr>
        <td class="mono small"><a href="/tickets/<%= ticket.key %>"><%= ticket.key %></a></td>
        <td><span class="badge"><%= ticket.type %></span></td>
        <td><%= ticket.title %></td>
        <td><span class="badge <%= ticket.status %>"><%= ticket.status %></span></td>
        <td class="small"><%= ticket.assignee || "—" %></td>
        <td class="small mono"><%= ticket.parent_key || "—" %></td>
        <td class="small mono"><% if (ticket.external_url) { %><a href="<%= ticket.external_url %>" target="_blank" rel="noreferrer"><%= ticket.external_key || "issue" %></a><% } else { %>—<% } %></td>
      </tr>
    <% } %>
    </tbody>
  </table>
</div>
<% } else { %>
<div class="empty">No tickets recorded for this build.</div>
<% } %>

<h2>Artifacts</h2>
<% if (artifacts && artifacts.length) { %>
<div class="card">
  <% for (const artifact of artifacts) { %>
  <div class="artifact">
    <h4><%= artifact.name %> <span class="badge"><%= artifact.kind %></span></h4>
    <% if (artifact.path) { %><p class="small muted mono"><%= artifact.path %></p><% } %>
    <% if (artifact.content) { %>
    <details>
      <summary>Preview</summary>
      <pre><%= String(artifact.content).slice(0, 12000) %></pre>
    </details>
    <% } %>
  </div>
  <% } %>
</div>
<% } else { %>
<div class="empty">No artifacts yet.</div>
<% } %>
<%- include("partials/footer") %>
