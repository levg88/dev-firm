<%- include("partials/header") %>
<h1>Build lab</h1>
<p class="lead">
  Describe a small app and the eight-role team will take it from brief to deployed,
  monitored code: product manager → architect → team lead → backend/frontend
  developers → tech lead → QA → DevOps.
  The delivery loop repeats until QA passes or the iteration limit is reached. Tasks and
  bugs are tracked on the ticket board and mirrored to GitHub Projects when configured.
</p>

<section class="card">
  <form method="post" action="/build">
    <div class="field">
      <label for="brief">Product brief</label>
      <textarea id="brief" name="brief" placeholder="A local CLI that..."></textarea>
    </div>
    <div class="row">
      <div class="field">
        <label for="title">Working title (optional)</label>
        <input id="title" type="text" name="title" placeholder="Inventory tracker">
      </div>
      <div class="field">
        <label for="max_iterations">Max delivery iterations</label>
        <input id="max_iterations" type="text" name="max_iterations" value="<%= settings.maxBuildIterations %>">
        <p class="small muted" style="margin: 5px 0 0;">Keep looping dev → tech lead → QA (and bug fixes) until QA passes.</p>
      </div>
    </div>
    <div class="row">
      <div class="field">
        <label for="repo_path">Existing repository <span class="muted">(optional)</span></label>
        <input id="repo_path" type="text" name="repo_path" placeholder="/Users/me/Workspace/existing-project">
        <p class="small muted" style="margin: 5px 0 0;">Leave blank to build in an isolated workspace. Set a path to work on an existing codebase.</p>
      </div>
      <div class="field" style="display: flex; align-items: flex-end;">
        <button type="submit">Run the build team</button>
      </div>
    </div>
  </form>
</section>

<h2>Build runs</h2>
<% if (workflows && workflows.length) { %>
<div class="card table-wrap">
  <table>
    <thead><tr><th>#</th><th>Title</th><th>Status</th><th>Created</th><th></th></tr></thead>
    <tbody>
    <% for (const workflow of workflows) { %>
      <tr>
        <td><%= workflow.id %></td>
        <td><%= workflow.title %></td>
        <td><span class="badge <%= workflow.status %>"><%= workflow.status %></span></td>
        <td class="small muted"><%= String(workflow.created_at || "").slice(0, 16).replace("T", " ") %></td>
        <td><a class="small" href="/build/<%= workflow.id %>">Open →</a></td>
      </tr>
    <% } %>
    </tbody>
  </table>
</div>
<% } else { %>
<div class="empty">No build runs yet.</div>
<% } %>
<%- include("partials/footer") %>
