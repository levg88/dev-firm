<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= typeof title !== "undefined" ? title : "Dev Firm" %></title>
  <link rel="stylesheet" href="/static/style.css">
</head>
<body>
  <header class="topbar">
    <a class="brand" href="/">
      <span class="brand-mark">DF</span>
      <span>Dev Firm</span>
    </a>
    <nav>
      <% if (settings.setupComplete) { %>
      <a href="/" class="<%= active === "home" ? "active" : "" %>">Dashboard</a>
      <a href="/build" class="<%= active === "build" ? "active" : "" %>">Build lab</a>
      <a href="/tickets" class="<%= active === "tickets" ? "active" : "" %>">Tickets</a>
      <a href="/chat" class="<%= active === "chat" ? "active" : "" %>">Chat</a>
      <a href="/runs" class="<%= active === "runs" ? "active" : "" %>">Runs</a>
      <a href="/agents" class="<%= active === "agents" ? "active" : "" %>">Agents</a>
      <a href="/settings" class="<%= active === "settings" ? "active" : "" %>">Settings</a>
      <% } else { %>
      <a href="/setup" class="active">Setup</a>
      <% } %>
    </nav>
  </header>

  <main class="container">
    <% if (llm_note) { %><div class="banner"><%= llm_note %></div><% } %>
    <% if (error) { %><div class="banner error"><%= error %></div><% } %>
    <% if (message) { %><div class="banner success"><%= message %></div><% } %>
