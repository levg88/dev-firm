<%- include("partials/header", { title: (editing ? "Settings" : "Setup") + " · Dev Firm" }) %>
<h1><%= editing ? "Settings" : "Set up Dev Firm" %></h1>
<p class="lead">
  <% if (editing) { %>
  Change the model provider, API key, or defaults. Everything is stored locally.
  <% } else { %>
  No config file needed. Choose how the build team thinks, then describe the app you
  want written. Everything is stored in your local database on this machine.
  <% } %>
</p>

<form method="post" action="<%= editing ? "/settings" : "/setup" %>">
  <section class="card">
    <h2 style="margin-top: 0;">Model provider</h2>
    <p class="small muted">
      Choose how the agents think. Offline mode works without a key and records
      placeholder artifacts; a real provider writes working code.
    </p>

    <div class="row">
      <div class="field">
        <label for="provider">Provider</label>
        <select id="provider" name="provider">
          <% for (const entry of providers) { const value = entry[0]; const label = entry[1]; %>
          <option value="<%= value %>" <%= settings.provider === value ? "selected" : "" %>><%= label %></option>
          <% } %>
        </select>
      </div>
      <div class="field">
        <label for="model">Model</label>
        <input id="model" type="text" name="model" value="<%= settings.model %>" placeholder="gpt-4.1">
      </div>
    </div>

    <div class="row">
      <div class="field">
        <label for="api_key">API key</label>
        <input id="api_key" type="password" name="api_key" autocomplete="new-password"
               placeholder="<%= settings.apiKeyHint ? "Current: " + settings.apiKeyHint + " — leave blank to keep" : "Paste your provider API key" %>">
        <p class="small muted" style="margin: 5px 0 0;">
          Leave blank to keep the current key. Required for OpenAI, Anthropic and
          OpenCode; not used by Ollama or Offline mode.
        </p>
      </div>
      <div class="field">
        <label for="base_url">Base URL <span class="muted">(optional)</span></label>
        <input id="base_url" type="text" name="base_url" value="<%= base_url %>" placeholder="https://api.openai.com/v1">
        <p class="small muted" style="margin: 5px 0 0;">
          Change this for OpenRouter, vLLM, a proxy, or a self-hosted Ollama endpoint.
        </p>
      </div>
    </div>

    <label style="display: flex; gap: 8px; align-items: center; font-weight: 500;">
      <input type="checkbox" name="clear_key" style="width: auto;">
      Clear the saved key for this provider
    </label>

    <details>
      <summary>Advanced model settings</summary>
      <div class="row" style="margin-top: 12px;">
        <div class="field">
          <label for="temperature">Temperature</label>
          <input id="temperature" type="text" name="temperature" value="<%= settings.temperature %>">
        </div>
        <div class="field">
          <label for="max_tokens">Max tokens per call</label>
          <input id="max_tokens" type="text" name="max_tokens" value="<%= settings.maxTokens %>">
        </div>
        <div class="field">
          <label for="max_agent_steps">Max agent steps</label>
          <input id="max_agent_steps" type="text" name="max_agent_steps" value="<%= settings.maxAgentSteps %>">
        </div>
        <div class="field">
          <label for="max_build_iterations">Max delivery iterations</label>
          <input id="max_build_iterations" type="text" name="max_build_iterations" value="<%= settings.maxBuildIterations %>">
        </div>
      </div>
      <label style="display: flex; gap: 8px; align-items: center; font-weight: 500;">
        <input type="checkbox" name="allow_heuristic_fallback" style="width: auto;"
               <%= settings.allowHeuristicFallback ? "checked" : "" %>>
        Fall back to offline placeholder output if a model call fails
      </label>
    </details>
  </section>

  <section class="card" style="margin-top: 16px;">
    <h2 style="margin-top: 0;">Chat concierge (fast model)</h2>
    <p class="small muted">
      The chat concierge can use a separate, faster model than the build agents.
      Hosted providers (OpenCode, OpenAI, Anthropic) make the chat snappy and
      instruction-following. Free OpenCode models rotate automatically when one
      is rate-limited. Leave blank to inherit the main provider/model.
    </p>
    <div class="field">
      <label for="concierge_provider">Concierge provider</label>
      <select id="concierge_provider" name="concierge_provider">
        <option value="" <%= !settings.conciergeProvider ? "selected" : "" %>>Inherit (main provider)</option>
        <option value="opencode" <%= settings.conciergeProvider === "opencode" ? "selected" : "" %>>opencode</option>
        <option value="openai" <%= settings.conciergeProvider === "openai" ? "selected" : "" %>>openai</option>
        <option value="anthropic" <%= settings.conciergeProvider === "anthropic" ? "selected" : "" %>>anthropic</option>
        <option value="ollama" <%= settings.conciergeProvider === "ollama" ? "selected" : "" %>>ollama</option>
      </select>
    </div>
    <div class="field">
      <label for="concierge_model">Concierge model</label>
      <input id="concierge_model" type="text" name="concierge_model" value="<%= settings.conciergeModel %>"
             placeholder="deepseek-v4.1-flash-free">
    </div>
    <div class="field">
      <label for="concierge_base_url">Concierge base URL (optional)</label>
      <input id="concierge_base_url" type="text" name="concierge_base_url" value="<%= settings.conciergeBaseUrl %>"
             placeholder="https://opencode.ai/inference/openai/v1">
    </div>
    <div class="field">
      <label for="concierge_api_key">Concierge API key (optional, falls back to provider key)</label>
      <input id="concierge_api_key" type="password" name="concierge_api_key" value=""
             placeholder="Leave blank to reuse the provider key">
    </div>
    <div class="field">
      <label for="concierge_fallback_models">Fallback models (comma-separated)</label>
      <input id="concierge_fallback_models" type="text" name="concierge_fallback_models"
             value="<%= (settings.conciergeFallbackModels || []).join(',') %>"
             placeholder="glm-5.3-flash-free,mimo-v2.6-flash-free,beam-free">
    </div>
  </section>

  <section class="card" style="margin-top: 16px;">
    <h2 style="margin-top: 0;">Repositories</h2>
    <p class="small muted">
      The chat concierge looks here when you name a repository (for example
      “add dark mode to career-firm”). It also uses this folder as the default
      place to start builds. Point it at the folder that contains your local
      git checkouts.
    </p>
    <div class="field">
      <label for="repos_dir">Local repositories folder</label>
      <input id="repos_dir" type="text" name="repos_dir" value="<%= settings.reposDir %>"
             placeholder="/Users/you/Workspace">
    </div>
  </section>

  <section class="card" style="margin-top: 16px;">
    <h2 style="margin-top: 0;">Task tracker / GitHub Projects</h2>
    <p class="small muted">
      When enabled, every product task, design hand-off, developer assignment, review,
      QA result, and bug is mirrored to GitHub Issues and a GitHub Project. The local
      ticket board always works, even without a project or token.
    </p>
    <label style="display: flex; gap: 8px; align-items: center; font-weight: 500;">
      <input type="checkbox" name="github_enabled" style="width: auto;"
             <%= settings.githubEnabled ? "checked" : "" %>>
      Sync the ticket board to GitHub
    </label>
    <div class="row" style="margin-top: 12px;">
      <div class="field">
        <label for="github_owner">Owner</label>
        <input id="github_owner" type="text" name="github_owner"
               value="<%= settings.githubOwner %>" placeholder="levg88">
      </div>
      <div class="field">
        <label for="github_repo">Repository</label>
        <input id="github_repo" type="text" name="github_repo"
               value="<%= settings.githubRepo %>" placeholder="career-firm">
      </div>
      <div class="field">
        <label for="ticket_prefix">Local ticket prefix</label>
        <input id="ticket_prefix" type="text" name="ticket_prefix"
               value="<%= settings.ticketPrefix %>" placeholder="CAREER">
      </div>
    </div>
    <div class="row">
      <div class="field">
        <label for="github_project_title">Project title</label>
        <input id="github_project_title" type="text" name="github_project_title"
               value="<%= settings.githubProjectTitle %>" placeholder="Career Team">
      </div>
      <div class="field">
        <label for="github_project_number">Project number <span class="muted">(0 = find by title)</span></label>
        <input id="github_project_number" type="text" name="github_project_number"
               value="<%= settings.githubProjectNumber %>" placeholder="0">
      </div>
    </div>
    <div class="row">
      <div class="field">
        <label for="github_token">GitHub token <span class="muted">(optional)</span></label>
        <input id="github_token" type="password" name="github_token" autocomplete="new-password"
               placeholder="<%= settings.githubTokenHint ? "Current: " + settings.githubTokenHint + " — leave blank to keep" : "Leave blank to use the gh CLI login" %>">
        <p class="small muted" style="margin: 5px 0 0;">
          Stored only in the local database. When blank, the authenticated
          <span class="mono">gh</span> CLI is used. Requires the <span class="mono">project</span> scope
          (<span class="mono">gh auth refresh -s project</span>).
        </p>
      </div>
      <div class="field">
        <label for="github_default_assignee">Default assignee login <span class="muted">(optional)</span></label>
        <input id="github_default_assignee" type="text" name="github_default_assignee"
               value="<%= settings.githubDefaultAssignee %>"
               placeholder="GitHub login used for issue assignment when mapped">
      </div>
    </div>
    <div class="field">
      <label for="github_assignees_json">Role → GitHub login map <span class="muted">(optional JSON)</span></label>
      <input id="github_assignees_json" type="text" name="github_assignees_json"
             value="<%= JSON.stringify(settings.githubAssigneeLogins) %>"
             placeholder='{"architect":"your-login"}'>
      <p class="small muted" style="margin: 5px 0 0;">
        Agents are not GitHub users. Commits use distinct role identities; issues use
        role labels, body attribution, and role-prefixed comments. A mapped login is
        only used for optional GitHub assignment.
      </p>
    </div>
    <label style="display: flex; gap: 8px; align-items: center; font-weight: 500;">
      <input type="checkbox" name="github_auto_create" style="width: auto;"
             <%= settings.githubAutoCreateProject ? "checked" : "" %>>
      Create the GitHub Project automatically if it does not exist
    </label>
    <label style="display: flex; gap: 8px; align-items: center; font-weight: 500; margin-top: 6px;">
      <input type="checkbox" name="clear_github_token" style="width: auto;">
      Clear the saved GitHub token
    </label>
  </section>

  <div class="banner" style="margin-top: 16px;">
    <strong>How it works:</strong> each build runs in
    <span class="mono">data/runs/build_&lt;id&gt;/workspace/</span>. The developer writes
    real files there and QA runs the test suite. You can review every agent call and
    artifact afterwards.
  </div>

  <div class="banner" style="margin-top: 16px;">
    <strong>Privacy:</strong> API keys are stored only in the local SQLite database
    (file permissions <span class="mono">0600</span>) and are sent only to the provider you
    choose. Do not expose this server to untrusted networks.
  </div>

  <div style="margin-top: 16px; display: flex; gap: 10px; align-items: center;">
    <button type="submit"><%= editing ? "Save settings" : "Save and open the firm" %></button>
    <span class="small muted">You can change all of this later in Settings.</span>
  </div>
</form>

<script>
  const modelSuggestions = <%- JSON.stringify(suggested_models || {}) %>;
  const baseSuggestions = <%- JSON.stringify(suggested_base_urls || {}) %>;
  const provider = document.getElementById("provider");
  const model = document.getElementById("model");
  const baseUrl = document.getElementById("base_url");
  provider.addEventListener("change", () => {
    const knownModels = Object.values(modelSuggestions);
    if (!model.value || knownModels.includes(model.value)) {
      model.value = modelSuggestions[provider.value] || "";
    }
    const knownBases = Object.values(baseSuggestions);
    if (!baseUrl.value || knownBases.includes(baseUrl.value)) {
      baseUrl.value = baseSuggestions[provider.value] || "";
    }
  });
</script>
<%- include("partials/footer") %>
